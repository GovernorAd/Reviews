# Порт API
PORT=4000

# Разрешённые источники через запятую (dev-клиент и preview-клиент)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# Секрет для подписи JWT. Обязательно замените в production!
JWT_SECRET=reviews-dev-secret-change-me

# Ставить флаг Secure у cookie (включайте только при работе через HTTPS)
COOKIE_SECURE=false

# Учётная запись администратора, создаётся при старте сервера.
# Обязательно замените пароль в production!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@reviews.local
ADMIN_PASSWORD=admin12345
